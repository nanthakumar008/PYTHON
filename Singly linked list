class Node:
def __init__(self, data):
self.data = data
self.next = None
Creating nodes
n1 = Node("Google Google")
n2 = Node("Jilla")
n3 = Node("Matta ")
n4 = Node("Vathi ridu")
n5 = Node("Varisu")
n6 = Node("TVK flag song")
n7 = Node("Master")
n8 = Node("Va thaliva")
n9 = Node("Thalapathi kachari")
Linking nodes
n1.next = n2
n2.next = n3
n3.next = n4
n4.next = n5
n5.next = n6
n6.next = n7
n7.next = n8
n8.next = n9
head = n1
def display(head):
temp = head
while temp:
print(temp.data)
temp = temp.next
print("Original Playlist")
display(head)
