def _init_(self):class Stack:    #Array Implementation

    def _init_(self):
        self.stack = []
       
    def push(self,item):
        self.stack.append(item)
        print(item,"is pushed to stack")
    def pop(self):
        if self.is_empty():
            return "Stack Underflow"
        return self.stack.pop()
    def peek(self):
        if self.is_empty():
            return "Stack is empty"
        return self.stack[-1]
    def is_empty(self):
        return len(self.stack) == 0
    def size(self):
        return len(self.stack)
    def display(self):
        print("Stack elements:", self.stack)

